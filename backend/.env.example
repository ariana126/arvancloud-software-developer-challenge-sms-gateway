NODE_ENV=development

POSTGRES_USER=local
POSTGRES_PASSWORD=local
POSTGRES_DB=mydb
POSTGRES_PORT=5432

JWT_SECRET="jwt-secret-change-it"

# Where the line between a high-volume sender and the long tail is drawn: more
# than this many sends inside the window below and a customer's standard traffic
# moves to its own dispatch lane, so its backlog stops being everyone else's.
# Both have defaults in code, so an older .env without them still boots.
SMS_BULK_TIER_THRESHOLD=1000
SMS_TRAFFIC_WINDOW_IN_SECONDS=60

# Host port for the Kafka broker's EXTERNAL listener. Only for pointing a tool
# at it from the host — the app and the workers reach it over the Compose
# network at kafka:9092, which docker-compose.yml sets directly.
KAFKA_PORT=9092