NODE_ENV=test

APP_PORT=3001
STUDIO_PORT=5556

POSTGRES_USER=local
POSTGRES_PASSWORD=local
POSTGRES_DB=testdb
POSTGRES_PORT=5433

JWT_SECRET="jwt-secret-change-it"

LOG_LEVEL=silent

# The broker's EXTERNAL listener, on a different host port from the dev stack's
# so both can run at once — which, after `make up`, is the normal state.
KAFKA_PORT=9094

# Deliberately low, so the acceptance suite can push a sender over the
# high-volume line in a handful of requests instead of a thousand. The real
# threshold is a capacity decision; what the suite is checking is that crossing
# it reclassifies the sender at all.
SMS_BULK_TIER_THRESHOLD=3
SMS_TRAFFIC_WINDOW_IN_SECONDS=60


# The transactional outbox relay. Off in the acceptance test stack: a poller
# sweeping a database the suite truncates between scenarios is a flake source
# with nothing to catch there, since the stand-in carrier never fails. The
# in-request publish is what the suite exercises, and the workers on the other
# side of the broker do the delivering.
OUTBOX_RELAY_ENABLED=false
